# Copie para .env e altere a password: cp .env.example .env
POSTGRES_PASSWORD=mude-esta-password

# Relatórios periódicos por e-mail (Gmail). A password NÃO é a da conta:
# é uma "palavra-passe de app" (16 letras) criada em
# https://myaccount.google.com/apppasswords (exige verificação em 2 passos).
GMAIL_USER=o-seu-endereco@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Hora (Lisboa) a partir da qual os relatórios do dia são enviados (0-23)
HORA_ENVIO=7
